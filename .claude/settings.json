{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-changed.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 120000,
  "enabledPlugins": {
    "caveman@caveman": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "120000"
  }
}
