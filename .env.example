# Dev values only; ops/compose.dev.yml starts this database (pnpm db:up). Copy to .env.
# Three logins: roofy_app serves every service query, roofy_auth serves only Better Auth, and
# roofy (the owner) runs migrations. `pnpm db:roles` sets LOGIN and the two passwords below.
DATABASE_URL=postgres://roofy_app:roofy_app_dev_pw@127.0.0.1:5440/roofy_dev
AUTH_DATABASE_URL=postgres://roofy_auth:roofy_auth_dev_pw@127.0.0.1:5440/roofy_dev
MIGRATE_DATABASE_URL=postgres://roofy:roofy_dev_pw@127.0.0.1:5440/roofy_dev
ROOFY_APP_DB_PASSWORD=roofy_app_dev_pw
ROOFY_AUTH_DB_PASSWORD=roofy_auth_dev_pw
# The same three for the integration tests. They must name a database ending in _test.
TEST_DATABASE_URL=postgres://roofy_app:roofy_app_dev_pw@127.0.0.1:5440/roofy_test
TEST_AUTH_DATABASE_URL=postgres://roofy_auth:roofy_auth_dev_pw@127.0.0.1:5440/roofy_test
TEST_MIGRATE_DATABASE_URL=postgres://roofy:roofy_dev_pw@127.0.0.1:5440/roofy_test
# Data layer: "fake" = the Phase 2 prototype's in-memory seed. Unset means fake in `pnpm dev` only;
# `pnpm start` runs with NODE_ENV=production and needs ROOFY_DATA=fake set explicitly (playwright's
# webServer sets it). Anything else throws until the real data layer arrives in Phase 3.
ROOFY_DATA=fake
# Optional: pin the fake clock (ISO instant). Default 2026-09-27T21:00:00Z = Mon 28 Sep 2026, 7 a.m. Sydney.
# ROOFY_FAKE_NOW=2026-09-27T21:00:00Z
# Email: "console" prints each message (dev and test); "smtp" sends through SMTP_URL from MAIL_FROM.
# Unset means console in dev and test, and an error under `pnpm start` (NODE_ENV=production).
# Dev and e2e launchers set ROOFY_MAIL=console explicitly. Production must choose smtp: console
# prints reset and invite links to the server log. Left commented so a copied .env cannot hide that.
# ROOFY_MAIL=console
# Needed when ROOFY_MAIL=smtp. Dev values only; real credentials go in .env, never in source.
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=Roofy <hello@localhost>
# Optional: also append one JSON line {to, subject, text, links} per message to this file.
# Db-mode e2e reads verification and invite links from it.
# ROOFY_MAIL_LOG=.superpowers/run/mail.jsonl
# Better Auth signing secret, required. Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the app is served from. An https URL makes the session cookie Secure.
# Behind a proxy, set X-Forwarded-For to the client address only ($remote_addr): sign-in limits are per IP.
BETTER_AUTH_URL=http://localhost:3100
# Optional: Google sign-in. Unset hides it ("Google sign-in is not set up"); set both to enable it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
